{
  "metadata": {
    "description": "VIS test fixture for all 43 modes, generated from src/modes.cpp",
    "specification": "MMSSTV VIS (SSTV Handbook 3.6.2): 1900 Hz 300 ms, 1200 Hz 10 ms, 1900 Hz 300 ms, 1200 Hz 30 ms start bit, data bits LSB-first 30 ms each (1100 Hz = 1, 1300 Hz = 0), 1200 Hz 30 ms stop bit. Standard VIS has 8 data bits whose bit 7 is the parity bit (910 ms): even parity, except MMSSTV's B/W 12 code 0x86 (odd). MR/MP/ML modes send a 16-bit word: 0x23 then the mode byte, each with odd parity (1150 ms). No separate parity tone is sent.",
    "total_modes": 43,
    "version": "2.0"
  },
